{
	"name": "ttcore-uploader",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:github": "oxlint --format=github",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/schema/auth.ts --yes"
	},
	"dependencies": {
		"postgres": "^3.4.8"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@discordjs/builders": "^1.14.1",
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@formisch/svelte": "^0.7.4",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"better-auth": "~1.4.22",
		"bits-ui": "^2.16.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^1.0.0-beta.20",
		"drizzle-orm": "^1.0.0-beta.20",
		"eslint-plugin-svelte": "^3.16.0",
		"formsnap": "^2.0.1",
		"globals": "^17.4.0",
		"jsrepo": "^3.7.0",
		"mode-watcher": "^1.1.0",
		"oxfmt": "^0.43.0",
		"oxlint": "^1.58.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"ulid": "^3.0.2",
		"valibot": "^1.3.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.3"
	},
	"overrides": {
		"better-sqlite3": "file:./stubs/better-sqlite3"
	}
}
